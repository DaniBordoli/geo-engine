# Copiá este archivo a .env.local y completá con tus keys. NO comitear .env.local.

# Agentes (Claude) — generador de prompts, analizador, fix pack
ANTHROPIC_API_KEY=

# Engines de Semana 1
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Postgres (Neon serverless). Ej: postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=

# Opcional: prompts por scan (free tier). Default 15.
SCAN_MAX_PROMPTS=

# Lemon Squeezy (pago único por fix pack)
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
