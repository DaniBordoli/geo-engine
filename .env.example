# Copiá este archivo a .env.local y completá con tus keys. NO comitear .env.local.

# Agentes (Claude) — generador de prompts, analizador, fix pack
ANTHROPIC_API_KEY=

# Engines de Semana 1
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Postgres (Neon serverless). Ej: postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=

# Opcional: prompts por scan (free tier). Default 15.
SCAN_MAX_PROMPTS=

# Lemon Squeezy (pago único por fix pack)
# El redirect post-pago se configura a nivel PRODUCTO en el dashboard de Lemon:
#   https://TU-APP/fixpack/resolve?order=[order_id]
# (no se puede fijar por query param en el checkout hosted sin el API key).
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Analytics (opcional): dominio de Plausible (cookieless). Sin esto, no carga nada.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Cola de generación (opcional). Sin esto, la generación corre inline en el webhook.
# Con QStash (Upstash) + secret, corre en /api/fixpack/generate (su propio maxDuration).
FIXPACK_QUEUE_SECRET=
QSTASH_TOKEN=
# APP_URL solo si no estás en Vercel (Vercel expone VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=

# Crawl headless para SPAs con shell vacío (opcional; pesado). "1" para activar.
ENABLE_HEADLESS_CRAWL=

# Admin: token para la vista privada del funnel en /admin/<ADMIN_TOKEN>.
ADMIN_TOKEN=
